# Copy to .env, fill in values. Never commit .env.

NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000

# 32+ byte random string, unique per environment
SESSION_SECRET=

# MongoDB — leave blank in dev to use an in-memory Mongo (MongoMemoryServer)
MONGODB_URI=
MONGODB_DB_NAME=guruji

# First-run staff seed (users can be managed from the Admin portal afterwards)
ADMIN_EMAIL=
ADMIN_PASSWORD=
GURUJI_EMAIL=
GURUJI_PASSWORD=
OWNER_EMAILS=

# PayU India — Hosted Checkout
# Get these from the PayU merchant dashboard. Use PAYU_MODE=test with sandbox keys first.
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
PAYU_MODE=test

# Google Sign-In (optional; a dev login button shows up when NODE_ENV=development)
GOOGLE_CLIENT_ID=

# Jitsi Meet — public instance for dev, self-hosted or JaaS for production
MEET_PROVIDER=public
MEET_BASE_URL=https://meet.jit.si

# Local uploads
UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=8388608

# Optional
# SUPPORT_EMAIL=care@adiguruayurveda.com
# CORS_ORIGINS=https://yourdomain.com
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=300
