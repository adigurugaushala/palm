{
  "name": "guruji",
  "version": "3.0.0",
  "description": "Guruji palmistry \u2014 Next.js front-end + Express API (MongoDB, PayU, Jitsi)",
  "private": true,
  "main": "server/index.js",
  "scripts": {
    "dev": "node --watch server/index.js",
    "build": "next build",
    "postinstall": "next build",
    "start": "node server/index.js",
    "test": "node --test tests/unit/*.test.js",
    "test:visual": "node tests/visual/shoot.js",
    "test:motion": "node tests/visual/motion-check.js",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium --with-deps"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/noto-sans": "^5.2.5",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@fontsource/noto-sans-telugu": "^5.3.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.0.0",
    "google-auth-library": "^9.15.0",
    "gsap": "^3.15.1",
    "helmet": "^8.0.0",
    "image-size": "^2.0.0",
    "lenis": "^1.3.27",
    "mongoose": "^9.0.0",
    "multer": "^2.0.0",
    "next": "^16.4.6",
    "pdfkit": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.0.0",
    "puppeteer-core": "^25.18.0"
  },
  "overrides": {
    "uuid": "^11.1.0"
  }
}
